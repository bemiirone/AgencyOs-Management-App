# ==========================================
# AgencyOS Environment Configuration (Example)
# Copy this file to .env and fill in your values
# ==========================================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/agencyos?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# Stripe (placeholder - replace with test keys)
STRIPE_SECRET_KEY=sk_test_placeholder_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_with_your_secret
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_replace_with_your_key

# SendGrid (placeholder - replace with your API key)
SENDGRID_API_KEY=SG.placeholder_replace_with_your_api_key
SENDGRID_FROM_EMAIL=noreply@agencyos.com
SENDGRID_FROM_NAME=AgencyOS

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# CORS
CORS_ORIGIN=http://localhost:4200
