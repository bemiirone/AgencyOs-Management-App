{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "types": [],
    "lib": ["es2022", "dom"],
    "emitDeclarationOnly": false,
    "declaration": false,
    "composite": false,
    "module": "ES2022",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
